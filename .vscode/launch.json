{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SteamArt: web UI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/steamart.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "SteamArt: web UI (no browser, verbose)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/steamart.py",
      "args": ["ui", "--no-browser", "--verbose"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "SteamArt: demo UI (fake Steam, safe)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/_uicheck.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "SteamArt: info",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/steamart.py",
      "args": ["info"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "SteamArt: list games",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/steamart.py",
      "args": ["list"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Debug the current test file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
